{
    "claudeCode.allowDangerouslySkipPermissions": false,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.DS_Store": true,
        "**/.venv": true,
        "**/venv": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/venv": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true
    },
    "python.analysis.exclude": [
        "**/.venv",
        "**/venv",
        "**/node_modules",
        "**/__pycache__"
    ],
    "pyrefly.exclude": [
        "**/.venv",
        "**/venv",
        "**/node_modules",
        "**/__pycache__"
    ]
}