# =============================================================================
# OraclePoly — Environment Variables
# =============================================================================
# Скопируйте в .env и заполните реальными значениями.
# Обязательные переменные помечены [REQUIRED].

# --- Database [REQUIRED] ---
DATABASE_URL=postgresql://oraclepoly:password@localhost:5432/oraclepoly

# Read-only роль для Portfolio Analyst Agent (Phase 0, §4.5 инвариант 6 least-privilege).
# Пароль генерируется отдельно на проде, НЕ существующий DATABASE_URL пароль.
AGENT_DATABASE_URL=postgresql://oraclepoly_agent_ro:CHANGE_ME@localhost:5432/oraclepoly

# --- Redis ---
# В production используйте пароль: redis://:YOUR_PASSWORD@host:port/db
REDIS_URL=redis://localhost:6379/0

# --- OpenAI [REQUIRED] ---
OPENAI_API_KEY=sk-...

# --- Telegram [REQUIRED] ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=

# --- Polymarket [REQUIRED] ---
POLYMARKET_API_KEY=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_ADDRESS=0x...
POLYMARKET_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# --- The Graph (on-chain resolution detection) ---
THEGRAPH_API_KEY=               # Free tier: 100K req/мес, https://thegraph.com/studio/

# --- Kalshi (Phase 1 MVP, see research/kalshi-integration-2026-05/prd.md) ---
KALSHI_API_KEY_ID=                                           # UUID из Kalshi Profile Settings
KALSHI_PRIVATE_KEY_PATH=/run/secrets/kalshi_rsa.pem          # Docker secret mount, RSA PEM
KALSHI_API_BASE_URL=https://demo-api.kalshi.co/trade-api/v2  # demo пока, после KYC: https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://demo-api.kalshi.co/trade-api/ws/v2
KALSHI_RATE_LIMIT_RPS=2.0
KALSHI_TIMEOUT_SEC=10.0

# --- Admin ---
# Один ключ (legacy) или список через запятую для zero-downtime ротации
ADMIN_API_KEY=YOUR_ADMIN_API_KEY
ADMIN_API_KEYS=key1,key2
# Telegram IDs с admin-доступом (JSON array)
ADMIN_TELEGRAM_IDS=[123456789]
JWT_SECRET_KEY=<generate-32+-char-random-string>

# --- CORS ---
# JSON array разрешённых origins
CORS_ORIGINS=["http://localhost:5173","https://yourdomain.com"]

# =============================================================================
# Optional — News, Vector Search, Scraping
# =============================================================================

# --- Qdrant (vector search) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Firecrawl (news scraping) ---
FIRECRAWL_API_KEY=

# --- Serper (fallback scraping) ---
SERPER_API_KEY=

# =============================================================================
# Optional — Storage, Payments, Monitoring
# =============================================================================

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oracle-data-lake

# --- Residential Proxy (IPRoyal Finland) — ТОЛЬКО для execution_job.py ---
# ВНИМАНИЕ: НЕ использовать имена HTTPS_PROXY / HTTP_PROXY / ALL_PROXY!
# Docker и httpx подхватят их как системные и пропустят ВЕСЬ трафик через прокси.
# Инцидент 2026-04-05: 1 GB лимит сгорел за день из-за HTTPS_PROXY в .env.
# Формат: http://user:password@geo.iproyal.com:12321
POLYMARKET_PROXY=
# ISO datetime истечения текущей прокси-сессии (алерт за 1 час до конца)
PROXY_EXPIRES_AT=

# --- IPRoyal Proxy Monitor ---
IPROYAL_API_TOKEN=
IPROYAL_TRAFFIC_ALERT_GB=1.0

# --- CryptoBot (Crypto Pay) ---
CRYPTOPAY_API_TOKEN=
# IP/CIDR whitelist для платёжных вебхуков (JSON array, пустой = без ограничений)
WEBHOOK_IP_WHITELIST=["149.154.160.0/20","91.108.4.0/22"]

# --- Sentry ---
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_TELEGRAM_BOT_USERNAME=YourBotUsername

# =============================================================================
# LLM Settings
# =============================================================================

LLM_PROVIDER=openai  # "openai" | "cloudflare" | "openrouter"
LLM_ANALYSIS_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1500

# --- Cloudflare Workers AI (free tier: 10K neurons/day) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_MODEL_CHAT=@cf/meta/llama-3.1-8b-instruct
# CF_MODEL_EMBEDDING=@cf/baai/bge-large-en-v1.5
# CF_EMBEDDING_DIM=1024

# --- OpenRouter (OpenAI-совместимый шлюз; embeddings для Manifold-matcher) ---
# Активировать: LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_DIM=1536
ADVISORY_EXPLAINER_MODEL=anthropic/claude-haiku-4.5
ADVISORY_EXPLAINER_ENABLED=false

# =============================================================================
# Bayesian Scoring / Calibration
# =============================================================================

SCORING_F_MAX=0.25
SCORING_K_LIQUIDITY=0.01
SCORING_W_MKT=1.0
SCORING_W_WHALE=1.0
SCORING_EXPERT_WEIGHT_ENABLED=true
SCORING_TIMING_BOOST_SCALE=0.1
SCORING_W_FRESH=0.6
SCORING_W_CLUSTER=0.7
SCORING_W_REGISTRY=0.3
SCORING_PRIOR_ALPHA=5.5
SCORING_PRIOR_BETA=4.5
SCORING_CREDIBILITY_GAMMA=0.97
SCORING_DECAY_ALPHA=0.52

# =============================================================================
# Thresholds
# =============================================================================

AI_ANALYSIS_THRESHOLD_USD=25000
WHALE_ALERT_THRESHOLD_USD=50000

# =============================================================================
# Anomaly Detection
# =============================================================================

ANOMALY_NEW_ACCOUNT_DAYS=7
ANOMALY_SINGLE_MARKET_MAX=2
ANOMALY_SINGLE_BET_MAX_TRADES=3
ANOMALY_SINGLE_BET_MIN_VOLUME=10000
ANOMALY_CONCENTRATION_THRESHOLD=0.9
ANOMALY_MIN_FLAGS=2
WS_SCORE_NOISE_FILTER=0.005

# =============================================================================
# Execution Bot
# =============================================================================

EXECUTION_ENABLED=false
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
# Builder Key для Relayer (auto-redeem выигрышных позиций)
POLYMARKET_BUILDER_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Redeem job — REDEEM_ENABLED=false (default): dry-run отчёт, ничего не отправляет on-chain.
# true — боевой redeem через poly-web3 SDK (ProxyWeb3Service.redeem_all(), Polymarket Relayer).
REDEEM_ENABLED=false

# =============================================================================
# Two-Stage ML Pipeline (Stage 4 / two-stage migration plan)
# =============================================================================
# 'monolith' = legacy L1+L2 (default).
# 'v2_two_stage' = Layer A (Event Selector) + Layer B (Market Picker).
# Switch only after Stage 5 cutover decision (HUMAN-only).
PIPELINE_VERSION=monolith
